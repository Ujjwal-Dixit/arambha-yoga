# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these under Settings → Environment Variables (see README).

# Postgres. Set automatically on Vercel by the Neon integration.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Vercel Blob, for images uploaded from /admin. Set automatically on Vercel by
# connecting a Blob store. Leave blank locally to save uploads to public/uploads.
BLOB_READ_WRITE_TOKEN=

# Admin sign-in (lib/auth.ts)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google accounts allowed into /admin
ADMIN_EMAILS=

# Telegram bot that receives website enquiries (lib/telegram.ts). While blank,
# enquiries are printed to the dev-server terminal instead.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
